+    assert.strictEqual(res.result?.isError, true, JSON.stringify(res).slice(0, 200));
+    const { code } = await stop(proc);
+    assert.strictEqual(code, 0);
+  });
+
+  test('6. invalid tool name is rejected', async () => {
