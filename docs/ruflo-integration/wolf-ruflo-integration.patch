+  });
+
+  test('5f. Wolf allowlist proxy: non-allowlisted tool is refused and not executed', async () => {
+    const proc = await startServer({ cwd: dir, proxy: true });
+    const res = await request(proc, 'tools/call', { name: 'system_info', arguments: {} });
